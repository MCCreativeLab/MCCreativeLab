From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: verdox-w <verdox@solarminer.app>
Date: Tue, 27 Oct 2026 14:03:15 +0000
Subject: [PATCH] Expose entity behavior handles through CraftEntity


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index 58fdb79adf624bc5a575e1ec296a9bd18c3d1801..34ffee28914e08042672b020f1eeb0cb01ada112 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -1441,4 +1441,24 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
             .removeIf(entry -> entry.getKey().namespace().equals(nameSpaced.namespace()));
     }
 
+    @Override
+    public <T extends org.bukkit.entity.Entity, B extends de.verdox.mccreativelab.behavior.entity.EntityBehaviour<T>> void setCustomEntityBehaviour(Class<? extends T> entityTypeClass, B behaviour) {
+        com.google.common.base.Preconditions.checkArgument(entityTypeClass.isInstance(this), "The entity does not match the requested behavior type");
+        this.getHandle().behaviour = behaviour;
+    }
+
+    @Override
+    public <T extends org.bukkit.entity.Entity, B extends de.verdox.mccreativelab.behavior.entity.EntityBehaviour<T>> B getCustomEntityBehaviour(Class<? extends B> behaviourType) {
+        return this.getCustomEntityBehaviourIfAvailable(behaviourType);
+    }
+
+    @Override
+    public <T extends org.bukkit.entity.Entity, B extends de.verdox.mccreativelab.behavior.entity.EntityBehaviour<T>> B getCustomEntityBehaviourIfAvailable(Class<? extends B> behaviourType) {
+        return behaviourType.isInstance(this.getHandle().behaviour) ? behaviourType.cast(this.getHandle().behaviour) : null;
+    }
+
+    @Override
+    public boolean hasCustomEntityBehaviour() {
+        return this.getHandle().behaviour != null;
+    }
 }
