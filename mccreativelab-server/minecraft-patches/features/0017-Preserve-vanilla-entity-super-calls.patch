From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: verdox-w <verdox@solarminer.app>
Date: Wed, 28 Oct 2026 16:48:00 +0000
Subject: [PATCH] Preserve vanilla super calls inside entity behaviour fallbacks

Calling a behaviour dispatcher from a vanilla superclass delegation re-enters
the subtype through its fallback and causes unbounded recursion. Dispatch at
external call sites while retaining direct vanilla superclass implementations.

diff --git a/net/minecraft/world/entity/TamableAnimal.java b/net/minecraft/world/entity/TamableAnimal.java
index 5a59f546bb4c2fac59071dd50c9c235b7a21fbb4..8881d76b5346baf5f14926696e93e07dc0889a24 100644
--- a/net/minecraft/world/entity/TamableAnimal.java
+++ b/net/minecraft/world/entity/TamableAnimal.java
@@ -182,7 +182,7 @@ public abstract class TamableAnimal extends Animal implements OwnableEntity {
 
     @Override
     public boolean canAttack(final LivingEntity target) {
-        return !this.isOwnedBy(target) && super.mcc$canAttack(target);
+        return !this.isOwnedBy(target) && super.canAttack(target);
     }
 
     public boolean isOwnedBy(final LivingEntity entity) {
diff --git a/net/minecraft/world/entity/animal/dolphin/Dolphin.java b/net/minecraft/world/entity/animal/dolphin/Dolphin.java
index 13a13e68a1582a6fc2851a9da3d35ff823c65d3a..274dd55ab20feb594f9f4290b1638979ed85f231 100644
--- a/net/minecraft/world/entity/animal/dolphin/Dolphin.java
+++ b/net/minecraft/world/entity/animal/dolphin/Dolphin.java
@@ -197,7 +197,7 @@ public class Dolphin extends AgeableWaterCreature {
 
     @Override
     public boolean canAttack(final LivingEntity target) {
-        return !this.isBaby() && super.mcc$canAttack(target);
+        return !this.isBaby() && super.canAttack(target);
     }
 
     @Override
diff --git a/net/minecraft/world/entity/animal/feline/Cat.java b/net/minecraft/world/entity/animal/feline/Cat.java
index 694a0a626422da50f80c778ddf078bf1541280e5..7e458b7cb5de06e38b0a00af2300f62ab582e88f 100644
--- a/net/minecraft/world/entity/animal/feline/Cat.java
+++ b/net/minecraft/world/entity/animal/feline/Cat.java
@@ -391,7 +391,7 @@ public class Cat extends TamableAnimal {
 
     @Override
     public boolean canMate(final Animal partner) {
-        return this.isTame() && partner instanceof Cat cat && cat.isTame() && super.mcc$canMate(partner);
+        return this.isTame() && partner instanceof Cat cat && cat.isTame() && super.canMate(partner);
     }
 
     @Override
diff --git a/net/minecraft/world/entity/animal/sheep/Sheep.java b/net/minecraft/world/entity/animal/sheep/Sheep.java
index 7b2c4563940f2731727479feea041d9939ab9291..450bdc5fab3b4e2fd9007595b339327adebbca60 100644
--- a/net/minecraft/world/entity/animal/sheep/Sheep.java
+++ b/net/minecraft/world/entity/animal/sheep/Sheep.java
@@ -313,7 +313,7 @@ public class Sheep extends Animal implements Shearable {
     @Override
     public void ate() {
         if (!new org.bukkit.event.entity.SheepRegrowWoolEvent((org.bukkit.entity.Sheep) this.getBukkitEntity()).callEvent()) return; // CraftBukkit
-        super.mcc$ate();
+        super.ate();
         this.setSheared(false);
         if (this.canAgeUp()) {
             this.ageUp(60);
diff --git a/net/minecraft/world/entity/animal/sniffer/Sniffer.java b/net/minecraft/world/entity/animal/sniffer/Sniffer.java
index 87bdd9d9e0f4bff3274b04ac32a66bcd8b7b7932..30d48c61bcefe547a798b1f640baf84019d3e77a 100644
--- a/net/minecraft/world/entity/animal/sniffer/Sniffer.java
+++ b/net/minecraft/world/entity/animal/sniffer/Sniffer.java
@@ -442,7 +442,7 @@ public class Sniffer extends Animal {
             return false;
         } else {
             Set<Sniffer.State> states = Set.of(Sniffer.State.IDLING, Sniffer.State.SCENTING, Sniffer.State.FEELING_HAPPY);
-            return states.contains(this.getState()) && states.contains(snifferPartner.getState()) && super.mcc$canMate(partner);
+            return states.contains(this.getState()) && states.contains(snifferPartner.getState()) && super.canMate(partner);
         }
     }
 
diff --git a/net/minecraft/world/entity/item/ItemEntity.java b/net/minecraft/world/entity/item/ItemEntity.java
index f8cf2a3a7cf1502579db4c015c8e70f918c76524..a1fa75b4a02187686f1bd18f409abd2e6cbe31be 100644
