@@ -1371,4 +1381,9 @@ public final class ItemStack implements DataComponentHolder, ItemInstance {
             .or(() -> Optional.ofNullable(this.getItem().getItemDamageSource(attacker)))
             .orElseGet(attacker::createDamageSource);
     }
+    public @Nullable de.verdox.mccreativelab.behavior.ItemBehaviour itemBehaviour;
+
+    public boolean canFitInsideContainerItems() {
+        return de.verdox.mccreativelab.behaviour.ItemBehaviourUtil.canFitInsideContainerItems(this);
+    }
