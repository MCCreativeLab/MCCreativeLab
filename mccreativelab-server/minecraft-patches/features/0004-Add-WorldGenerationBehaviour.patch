                                                     if (section != null) {
                                                         int sectionRelativeX = SectionPos.sectionRelative(x);
                                                         int sectionRelativeY = SectionPos.sectionRelative(y);
@@ -157,6 +158,7 @@ public class OreFeature extends AbstractOreFeature {
                                                                 section.setBlockState(
                                                                     sectionRelativeX, sectionRelativeY, sectionRelativeZ, targetState.state(), false
                                                                 );
+                                                                de.verdox.mccreativelab.worldgen.WorldGenerationCallbackUtil.executeWorldGenCallbacks(de.verdox.mccreativelab.behavior.WorldGenerationBehaviour.FeatureType.ORE_FEATURE, level, orePos.immutable(), targetState.state(), sectionAndChunk.getSecond());
