diff --git a/net/minecraft/world/level/chunk/BulkSectionAccess.java b/net/minecraft/world/level/chunk/BulkSectionAccess.java
index 84733ae2f3543089a675d82542e77123044de477..8283405000cc996efb0cf3956b13cb68a4abd223 100644
--- a/net/minecraft/world/level/chunk/BulkSectionAccess.java
+++ b/net/minecraft/world/level/chunk/BulkSectionAccess.java
@@ -57,4 +57,12 @@ public class BulkSectionAccess implements AutoCloseable {
             section.release();
         }
     }
+    public @Nullable com.mojang.datafixers.util.Pair<LevelChunkSection, ChunkAccess> getSectionAndChunkAccess(final BlockPos pos) {
+        LevelChunkSection section = this.getSection(pos);
+        if (section == null) {
+            return null;
+        }
+        ChunkAccess chunk = this.level.getChunk(SectionPos.blockToSectionCoord(pos.getX()), SectionPos.blockToSectionCoord(pos.getZ()));
+        return com.mojang.datafixers.util.Pair.of(section, chunk);
+    }
 }
