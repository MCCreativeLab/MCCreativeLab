From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: verdox <mail.ysp@web.de>
Date: Mon, 27 Jan 2025 15:20:46 +0000
Subject: [PATCH] Add MCCWorldHook


diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index c14996f1d8a9ed77a845a464c1789bab0715741b..58c49939bf3fe1dfd2e69a1b9b490aaa373e8923 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -161,6 +161,7 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
     public int wakeupInactiveRemainingMonsters;
     public int wakeupInactiveRemainingVillagers;
     // Paper end - EAR 2
+    public de.verdox.mccreativelab.behavior.MCCWorldHook mccWorldHook = new de.verdox.mccreativelab.behavior.MCCWorldHook() {};
     public boolean populating;
     public final org.spigotmc.SpigotWorldConfig spigotConfig; // Spigot
     // Paper start - add paper world config
@@ -1182,6 +1183,7 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
 
             if ((updateFlags & Block.UPDATE_SKIP_POI) == 0) // Paper - temporary flag
             this.updatePOIOnBlockStateChange(pos, oldState, newState);
+            this.mccWorldHook.onBlockChange(org.bukkit.craftbukkit.block.CraftBlock.at(this, pos), oldState.asBlockData(), newState.asBlockData());
         }
     }
     // CraftBukkit end
diff --git a/net/minecraft/world/level/block/Block.java b/net/minecraft/world/level/block/Block.java
index 1b89d481168347f8edd078a8ac190b38a4390a6f..97dd4a78afbb29177716ecbe3963f6c2d148b902 100644
--- a/net/minecraft/world/level/block/Block.java
+++ b/net/minecraft/world/level/block/Block.java
@@ -447,7 +447,12 @@ public class Block extends BlockBehaviour implements ItemLike {
         , final boolean dropExperience // Paper - Properly handle xp dropping
     ) {
         if (level instanceof ServerLevel serverLevel) {
-            getDrops(state, serverLevel, pos, blockEntity, breaker, tool).forEach(stack -> popResource(level, pos, stack));
+            List<org.bukkit.inventory.ItemStack> loot = new java.util.ArrayList<>();
+            for (ItemStack drop : getDrops(state, serverLevel, pos, blockEntity, breaker, tool)) {
+                loot.add(drop.asBukkitCopy());
+            }
+            level.mccWorldHook.onBlockDrawLoot(org.bukkit.craftbukkit.block.CraftBlock.at(level, pos), breaker == null ? null : breaker.getBukkitEntity(), tool.asBukkitMirror(), dropExperience, loot);
+            loot.stream().map(org.bukkit.craftbukkit.inventory.CraftItemStack::asNMSCopy).forEach(stack -> popResource(level, pos, stack));
             state.spawnAfterBreak(serverLevel, pos, tool, dropExperience); // Paper - Properly handle xp dropping
         }
     }
